#include "tesmio_api.h"

static const TsmHost* g_host;

extern "C" __declspec(dllexport) unsigned TsmPluginApiVersion(void) {
    return TSM_API_VERSION;
}

extern "C" __declspec(dllexport) int TsmPluginInit(
    const TsmHost* host, TsmPluginInfo* info) {
    g_host = host;
    info->name = "simple-mod-hook";
    info->version = "1.0.0";
    g_host->log("simple    hook initialized");
    return 0;
}

extern "C" __declspec(dllexport) int TsmPluginStart(void) {
    // Consume cross-plugin services and install verified hooks here.
    const TsmResourceApi* resources = (const TsmResourceApi*)
        g_host->consume(TSM_SERVICE_RESOURCES, TSM_RESOURCES_VERSION);
    if (!resources) {
        g_host->log("simple    resources service unavailable - inactive");
        return 1;
    }
    return 0;
}
